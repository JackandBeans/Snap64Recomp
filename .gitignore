# Build output
build-win/
build-linux/
*.obj
*.pdb
*.ilk
*.exp
*.map

# Game ROM (copyrighted — never commit) and runtime artifacts
*.z64
*.n64
*.v64
*.dll
saves/
snapsettings.json
*.log

# Generated by N64Recomp from pokemonsnap.us.toml — regenerate, don't track
RecompiledFuncs/
# The recompiler's ELF input (the decomp's link, --emit-relocs), placed in the
# port root as pokemonsnap.relocs.elf; see BUILDING.md. Derived from the ROM.
*.elf

# Generated by N64Recomp from patches.toml, and the patch build it reads.
# The patch sources are tracked; everything derived from them is not.
RecompiledPatches/
patches/build/
# patches/game_syms.ld and patches/pokemonsnap.syms.toml ARE tracked: they hold
# only symbol names, addresses and sizes (no code or data bytes), and the patch
# build cannot run from a checkout without them. Regenerate with
# tools/gen_reference_syms.py when the decomp's symbols change.

# Vendored third-party trees (kept out to keep the repo reviewable).
# lib/rt64/src outside contrib IS tracked: it holds this port's renderer work.
lib/rt64/src/contrib/
lib/SDL/
lib/DirectX-Headers/

# Python
__pycache__/

# ROM-derived, and never to return: the menu font and furniture pixels are
# harvested from RDRAM at run time (src/menu_harvest.cpp), and the audio
# microcode is recompiled into the build tree (rsp/aspMain.us.toml.in).
/src/menu_font.h
/src/menu_dot.h
/tools/menu_font_harvest.json
/tools/menu_glyphs.py
/rsp/aspMain.cpp
# The run-time harvest's SNAP_STATS dump (src/menu_harvest.cpp).
menu_font_runtime.json

# Editor / OS
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

# N64Recomp ELF dumps (dump.toml, data_dump.toml): nothing reads them; keep local copies out of git.
dump.toml
data_dump.toml
