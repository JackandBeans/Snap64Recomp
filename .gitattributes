# GitHub's language statistics: the vendored runtime and renderer trees are
# not this port's own code (the port's changes to them are marked in place
# and listed in NOTICE.md), and the printer's font header is generated.
lib/**                          linguist-vendored
src/snap_station_osd_font.h     linguist-generated
# The patch build's symbol files are written by tools/gen_reference_syms.py
# from the decompilation (BUILDING.md, step 7); 600 KB of them would
# otherwise show as "Linker Script" beside the code.
patches/game_syms.ld            linguist-generated
patches/pokemonsnap.syms.toml   linguist-generated
# Binary assets, never diffed or line-ending converted.
*.ico  binary
*.png  binary
*.bin  binary
*.inputs binary

# The pad mapping list is read by SDL line by line and shipped as it is
# checked out; it stays LF everywhere so the packaged copy is the tested one.
assets/gamecontrollerdb.txt     text eol=lf
# The Gradle wrapper is a shell script that the Android build runs under
# WSL or Linux; with CRLF its first line names "bash\r" and nothing starts.
android/gradlew                 text eol=lf
tools/android/*.sh              text eol=lf
# Run under WSL on the Windows release machine, where CRLF breaks it the same way.
tools/release/sign_apk.sh       text eol=lf
