// Version resource: what Explorer's Properties > Details and Task Manager
// show for the executable. Filled in by CMake from the same numbers as
// version.h (CMakeLists.txt, "Version").
#include <winver.h>

// The executable icon (Explorer, the taskbar, the window): the port's logo,
// docs/logo.png, composed into src/snap64.ico by tools/icon_gen.py.
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/snap64.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      @SNAP_RC_FILEFLAGS@
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "JackandBeans"
            VALUE "FileDescription",  "@SNAP_PRODUCT_NAME@"
            VALUE "FileVersion",      "@SNAP_VERSION_FULL@"
            VALUE "InternalName",     "Snap64Recomp"
            VALUE "LegalCopyright",   "Copyright (C) 2026 JackandBeans, GPLv3. Not affiliated with Nintendo; Pokemon is a trademark of its owners."
            VALUE "OriginalFilename", "Snap64Recomp.exe"
            VALUE "ProductName",      "@SNAP_PRODUCT_NAME@"
            VALUE "ProductVersion",   "@SNAP_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
