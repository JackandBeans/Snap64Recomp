+inline bool ensureDumpDir() {
+    static int state = 0;
+    if (state == 0) {
+#if defined(_WIN32)
+        const int result = _mkdir("snap_frame_dumps");
+#else
+        const int result = mkdir("snap_frame_dumps", 0755);
+#endif
+        state = ((result == 0) || (errno == EEXIST)) ? 1 : -1;
+    }
+    return state == 1;
+}
