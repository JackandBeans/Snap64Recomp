+                    out[x * 3 + 1] = p[3];
+                    out[x * 3 + 2] = p[1];
+                }
+                else if (job.sourceIsBGRA) {
+                    out[x * 3 + 0] = p[0];
+                    out[x * 3 + 1] = p[1];
+                    out[x * 3 + 2] = p[2];
+                }
+                else {
+                    out[x * 3 + 0] = p[2];
+                    out[x * 3 + 1] = p[1];
+                    out[x * 3 + 2] = p[0];
+                }
+            }
+        }
